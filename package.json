{
  "name": "creativemountain-liveness",
  "version": "0.1.0",
  "private": true,
  "description": "《创界山·活人认证》2026 重制版 — 桌面多人策略游戏，实体+数字双轨",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:engine": "node --test \"tests/engine/**/*.test.ts\"",
    "test:gates": "node --test \"tests/gates/**/*.test.ts\"",
    "doc-sync": "node tools/doc-sync.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "build:only": "node esbuild.config.mjs",
    "gate": "node tools/gate.mjs",
    "build:ir": "node build/build-ir.mjs",
    "build:print": "esbuild build/build-print.ts --bundle --platform=node --format=esm --external:playwright --outfile=build/.build-print.mjs --log-level=error && node build/build-print-all.mjs",
    "print": "npm run build:ir && npm run build:print"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.60.0",
    "typescript": "^5.6.0"
  }
}
