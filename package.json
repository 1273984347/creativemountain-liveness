{
  "name": "creativemountain-liveness",
  "version": "0.1.0",
  "private": true,
  "description": "《创界山·活人认证》2026 重制版 — 桌面多人策略游戏，实体+数字双轨",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:engine": "node --test \"tests/engine/**/*.test.ts\"",
    "test:gates": "node --test \"tests/gates/**/*.test.ts\"",
    "test:e2e": "npm run build:only && node tests/e2e/duel-e2e.mjs",
    "test:e2e:playtest": "npm run build:only && node tests/e2e/duel-e2e.mjs",
    "doc-sync": "node tools/doc-sync.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "build:only": "node esbuild.config.mjs",
    "gate": "node tools/gate.mjs",
    "build:ir": "node build/build-ir.mjs",
    "build:print": "node build/build-print-all.mjs",
    "print": "npm run build:ir && npm run build:print",
    "build:package": "node build/build-package.mjs",
    "release:check": "node tools/release-check.mjs",
    "release": "npm run release:check && npm run build && npm run build:print && npm run build:package",
    "env:laya": "node tools/laya-sidecar/env-check.mjs",
    "sidecar:laya": "node tools/laya-sidecar/up.mjs --weights D:/<local-libs>/laya-multilingual/model.safetensors",
    "probe:laya": "node tools/laya-probe/run.mjs",
    "probe:laya:browser": "node tools/laya-probe/browser.mjs",
    "probe:laya:skip": "node tools/laya-probe/skip.mjs",
    "eval:faces": "node tools/laya-probe/game-arms.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.60.0",
    "typescript": "^7.0.2"
  }
}
